  uiModeSelection: {fileID: 319251046}
  explorePivot: {fileID: 1671187613}
  exploreDropdown: {fileID: 1688538729}
  exploreParts:
  - name: Anatomical Postion
    modelPart: {fileID: 940379544}
  - name: Saggittal plane
    modelPart: {fileID: 117590366}
  - name: Transverse plane
    modelPart: {fileID: 1375343533}
  - name: Coronal plane
    modelPart: {fileID: 390003403}
  sliderRotX: {fileID: 1897634917}
  sliderRotY: {fileID: 329609986}
  sliderRotZ: {fileID: 1135024295}
  sliderZoom: {fileID: 291417241}
  instructionText: {fileID: 1436199404625087210}
  btnNextStep: {fileID: 1271475074}
  labAudioSource: {fileID: 544357010}
  typeWriterSpeed: 0.05
  learningSteps:
  - name: Intro to Anotomical Pos
    instruction: 'Welcome to the Lab. Observe the Standard Anatomical Position: standing
      upright, feet together, palms facing forward. '
    visualRoot: {fileID: 201885007}
    interactionPart: {fileID: 0}
    requireInteraction: 0
    voiceClip: {fileID: 8300000, guid: 16fba6d30ed741d4a9fdd6e79ee2f3ac, type: 3}
  - name: Step_Sagittal
    instruction: This is the Sagittal Plane. It is a vertical plane that divides
      the body into Right and Left sections. Grab the plane to verify.
    visualRoot: {fileID: 214245300}
    interactionPart: {fileID: 1255901708}
    requireInteraction: 1
    voiceClip: {fileID: 8300000, guid: 16fba6d30ed741d4a9fdd6e79ee2f3ac, type: 3}
  - name: Step_Transverse
    instruction: This is the Transverse Plane (or Axial). It runs horizontally, dividing
      the body into Superior (Upper) and Inferior (Lower) parts. Grab it to continue.
    visualRoot: {fileID: 1003793616}
    interactionPart: {fileID: 505223256}
    requireInteraction: 1
    voiceClip: {fileID: 8300000, guid: 16fba6d30ed741d4a9fdd6e79ee2f3ac, type: 3}
  - name: Step_Coronal
    instruction: This is the Coronal Plane (or Frontal). It divides the body into
      Anterior (Front) and Posterior (Back) sections. Interact with the object.
    visualRoot: {fileID: 796929779}
    interactionPart: {fileID: 1193677680}
    requireInteraction: 1
    voiceClip: {fileID: 8300000, guid: 16fba6d30ed741d4a9fdd6e79ee2f3ac, type: 3}
  - name: Outro_Finished
    instruction: Excellent work. You have identified all three major planes of the
      body. You can now enter Interactive Mode to explore freely.
    visualRoot: {fileID: 201885007}
    interactionPart: {fileID: 0}
    requireInteraction: 0
    voiceClip: {fileID: 8300000, guid: 16fba6d30ed741d4a9fdd6e79ee2f3ac, type: 3}
